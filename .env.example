# ──────────────────────────────────────────────
# Nutri-Voice — Docker Environment Variables
# Copy this file to .env and fill in the values
# ──────────────────────────────────────────────

# ── Infrastructure ───────────────────────────
POSTGRES_PASSWORD=postgres

# ── Shared Secrets ───────────────────────────
JWT_SECRET=change-me-to-a-strong-secret
INTERNAL_TOKEN=change-me-to-a-shared-internal-token

# ── IDM Service ──────────────────────────────
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=14

# ── Telegram Integration ────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_WEBHOOK_URL=
TELEGRAM_COACH_ID=

# ── MCP / AI ─────────────────────────────────
OPENAI_API_KEY=
OPENAI_API_MODE=responses
OPENAI_RESPONSES_STORE=true
OPENAI_RESPONSES_CANARY_PERCENT=0
MCP_SERVICE_URL=http://mcp-service:4020
REDIS_URL=redis://redis:6379

# ── Frontend / CORS ───────────────────────────
SAAS_PUBLIC_API_URL=/
CORS_ORIGINS=http://localhost:8081

# ── Ngrok ─────────────────────────────────────
NGROK_AUTHTOKEN=

# ── Dozzle Logs UI ────────────────────────────
DOZZLE_BASIC_AUTH_USERNAME=vaitzman
DOZZLE_BASIC_AUTH_PASSWORD=HBS
