# ──────────────────────────────────────────────
# Nutri-Voice — Docker Environment Variables
# Copy this file to .env and fill in the values
# ──────────────────────────────────────────────

# ── Infrastructure ───────────────────────────
POSTGRES_PASSWORD=postgres

# ── Shared Secrets ───────────────────────────
JWT_SECRET=change-me-to-a-strong-secret
INTERNAL_TOKEN=change-me-to-a-shared-internal-token

# ── IDM Service ──────────────────────────────
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=14

# ── Telegram Integration ────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_WEBHOOK_URL=
TELEGRAM_COACH_ID=

# ── MCP / AI ─────────────────────────────────
OPENAI_API_KEY=
MCP_SERVICE_URL=http://mcp-service:4020
REDIS_URL=redis://redis:6379
